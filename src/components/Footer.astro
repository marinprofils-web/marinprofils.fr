---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer-main">

    <!-- Présentation -->
    <div class="site-footer-intro">
      <a href="/" class="footer-logo" aria-label="Retour à l'accueil">
        <span class="footer-logo-symbol" aria-hidden="true">
          <span class="footer-logo-m">M</span>
          <span class="footer-logo-p">P</span>
        </span>

        <span class="footer-logo-text">
          <strong>Marin Profils</strong>
          <small>Acier sur mesure</small>
        </span>
      </a>

      <p>
        Fabrication en Dordogne de tôles imitation tuile, bacs acier,
        bardages et accessoires pour les professionnels.
      </p>
    </div>

    <!-- Produits -->
    <details class="footer-column" open>
      <summary>
        <span class="footer-column-title">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7 12 3l8 4-8 4-8-4Z"></path>
            <path d="m4 7 8 4 8-4"></path>
            <path d="M4 7v10l8 4 8-4V7"></path>
          </svg>

          Produits
        </span>

        <span class="footer-column-arrow" aria-hidden="true"></span>
      </summary>

      <nav aria-label="Produits">
        <a href="/tole-imitation-tuile">
          Tôle imitation tuile
          <span aria-hidden="true">›</span>
        </a>

        <a href="/bac-acier">
          Bac acier
          <span aria-hidden="true">›</span>
        </a>

        <a href="/bardage">
          Bardage
          <span aria-hidden="true">›</span>
        </a>
      </nav>
    </details>

    <!-- Entreprise -->
    <details class="footer-column" open>
      <summary>
        <span class="footer-column-title">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 21V9l6 3V6l5 3V3l5 3v15H4Z"></path>
            <path d="M8 17h2"></path>
            <path d="M14 17h2"></path>
          </svg>

          Entreprise
        </span>

        <span class="footer-column-arrow" aria-hidden="true"></span>
      </summary>

      <nav aria-label="Entreprise">
        <a href="/fabrication">
          Fabrication
          <span aria-hidden="true">›</span>
        </a>

        <a href="/couleurs">
          Couleurs
          <span aria-hidden="true">›</span>
        </a>

        <a href="/realisations">
          Réalisations
          <span aria-hidden="true">›</span>
        </a>
      </nav>
    </details>

    <!-- Contact -->
    <details class="footer-column" open>
      <summary>
        <span class="footer-column-title">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 3H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3l-4-1-2 2a15 15 0 0 1-9-9l2-2-1-4Z"></path>
          </svg>

          Contact
        </span>

        <span class="footer-column-arrow" aria-hidden="true"></span>
      </summary>

      <div class="footer-contact">
        <p>Réservé aux professionnels</p>
        <p>Marsac-sur-l’Isle, Dordogne</p>

        <a href="/contact">
          Demander un devis
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </details>

  </div>

  <div class="container site-footer-bottom">
    <p>© {currentYear} Marin Profils. Tous droits réservés.</p>
  </div>
</footer>
