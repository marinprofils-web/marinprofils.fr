<header class="header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Accueil Marin Profils">
      <img
        src="/images/logo-marin-profils-long.png"
        alt="Marin Profils"
        class="brand-logo"
        width="360"
        height="80"
      />
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
    </button>

    <nav class="menu" id="main-menu" aria-label="Navigation principale">
      <a href="/produits">Produits</a>
      <a href="/fabrication">Fabrication</a>
      <a href="/couleurs">Couleurs</a>
      <a href="/realisations">Réalisations</a>
      <a href="/contact">Contact</a>

      <a class="quote-btn" href="/contact">
        <span class="quote-icon" aria-hidden="true">▣</span>
        <span>Demande de devis</span>
        <span class="quote-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .header {    position: sticky;    top: 0;    z-index: 1000;    width: 100%;    background: rgba(255, 255, 255, 0.98);    border-bottom: 1px solid rgba(31, 31, 31, 0.1);    box-shadow: 0 6px 24px rgba(6, 16, 31, 0.06);    backdrop-filter: blur(12px);  }
  .nav {    position: relative;    display: flex;    align-items: center;    justify-content: space-between;    min-height: 82px;    gap: 30px;  }
  .brand {    display: flex;    align-items: center;    flex-shrink: 0;    text-decoration: none;  }
  .brand-logo {    display: block;    width: auto;    height: 52px;    max-width: 280px;    object-fit: contain;  }
  .menu {    display: flex;    align-items: center;    justify-content: flex-end;    gap: 28px;  }
  .menu > a:not(.quote-btn) {    position: relative;    padding: 29px 0;    color: #1f1f1f;    font-family: Saira, Montserrat, sans-serif;    font-size: 0.98rem;    font-weight: 600;    line-height: 1;    text-decoration: none;    transition:      color 0.2s ease,      opacity 0.2s ease;  }
  .menu > a:not(.quote-btn)::after {    content: "";    position: absolute;    right: 0;    bottom: 20px;    left: 0;    height: 2px;    background: #004aad;    transform: scaleX(0);    transform-origin: center;    transition: transform 0.2s ease;  }
  .menu > a:not(.quote-btn):hover {    color: #004aad;  }
  .menu > a:not(.quote-btn):hover::after {    transform: scaleX(1);  }
  .quote-btn {    display: inline-flex;    align-items: center;    justify-content: center;    gap: 10px;    min-height: 46px;    padding: 12px 18px;    color: #fff;    font-family: Saira, Montserrat, sans-serif;    font-size: 0.94rem;    font-weight: 700;    line-height: 1.2;    text-decoration: none;    background: #004aad;    border-radius: 10px;    box-shadow: 0 8px 20px rgba(0, 74, 173, 0.18);    transition:      transform 0.2s ease,      background 0.2s ease,      box-shadow 0.2s ease;  }
  .quote-btn:hover {    background: #003b8a;    box-shadow: 0 10px 24px rgba(0, 74, 173, 0.25);    transform: translateY(-1px);  }
  .quote-arrow {    font-size: 1.15rem;    transition: transform 0.2s ease;  }
  .quote-btn:hover .quote-arrow {    transform: translateX(3px);  }
  .mobile-toggle {    display: none;    width: 48px;    height: 48px;    padding: 12px;    border: 1px solid rgba(31, 31, 31, 0.12);    border-radius: 10px;    background: #f2f6fc;    cursor: pointer;  }
  .mobile-toggle-line {    display: block;   width: 100%;    height: 2px;    margin: 5px 0;    background: #1f1f1f;    border-radius: 10px;    transition:      transform 0.25s ease,      opacity 0.2s ease;  }

  @media (max-width: 900px) {
    .nav {      min-height: 72px;      gap: 15px;    }
    .brand-logo {      height: 44px;      max-width: 225px;    }
    .mobile-toggle {      display: block;      flex-shrink: 0;    }
    .mobile-toggle[aria-expanded="true"] .mobile-toggle-line:nth-child(1) {     transform: translateY(7px) rotate(45deg);    }
    .mobile-toggle[aria-expanded="true"] .mobile-toggle-line:nth-child(2) {      opacity: 0;    }
    .mobile-toggle[aria-expanded="true"] .mobile-toggle-line:nth-child(3) {      transform: translateY(-7px) rotate(-45deg);    }
    .menu {      position: absolute;      top: calc(100% + 1px);      right: 0;      left: 0;      display: grid;      grid-template-columns: 1fr;      gap: 0;      max-height: 0;      padding: 0 18px;      overflow: hidden;      visibility: hidden;      background: #fff;      border-bottom: 1px solid rgba(31, 31, 31, 0.1);      box-shadow: 0 18px 32px rgba(6, 16, 31, 0.14);      opacity: 0;      transform: translateY(-10px);      transition:        max-height 0.35s ease,        padding 0.35s ease,        opacity 0.25s ease,        transform 0.25s ease,        visibility 0.25s ease;    }
    .menu.is-open {      max-height: calc(100vh - 72px);      padding-top: 12px;      padding-bottom: 22px;      overflow-y: auto;      visibility: visible;      opacity: 1;     transform: translateY(0);    }
    .menu > a:not(.quote-btn) {     display: flex;      align-items: center;      min-height: 58px;      padding: 16px 4px;      font-size: 1.05rem;      border-bottom: 1px solid rgba(31, 31, 31, 0.08);    }
    .menu > a:not(.quote-btn)::after {      display: none;    }
    .menu > a:not(.quote-btn)::before {      content: "→";      order: 2;      margin-left: auto;      color: #004aad;      font-size: 1.1rem;    }
    .quote-btn {      width: 100%;     min-height: 54px;      margin-top: 18px;      padding: 15px 18px;      font-size: 1rem;    }
  }

  @media (max-width: 420px) {
    .brand-logo {      height: 38px;      max-width: 190px;    }
    .mobile-toggle {      width: 44px;      height: 44px;      padding: 10px;    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,    .mobile-toggle-line,    .quote-btn,    .quote-arrow {      transition: none;    }
  }
</style>

<script>
  function initialiseMobileMenu() {
    const header = document.querySelector(".header");
    const toggle = header?.querySelector(".mobile-toggle");
    const menu = header?.querySelector(".menu");

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(menu instanceof HTMLElement)) return;

    const openMenu = () => {
      menu.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Fermer le menu");
    };

    const closeMenu = () => {
      menu.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Ouvrir le menu");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      if (!header?.contains(event.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        toggle.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 900) {
        closeMenu();
      }
    });
  }

  document.addEventListener("astro:page-load", initialiseMobileMenu);
  initialiseMobileMenu();
</script>
