<header class="header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Accueil Marin Profils">
      <img
        src="/images/logo-marin-profils-long.png"
        alt="Marin Profils"
        class="brand-logo"
        width="360"
        height="80"
      />
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
      <span class="mobile-toggle-line"></span>
    </button>

    <nav class="menu" id="main-menu" aria-label="Navigation principale">
      <a href="/produits">Produits</a>
      <a href="/fabrication">Fabrication</a>
      <a href="/couleurs">Couleurs</a>
      <a href="/realisations">Réalisations</a>
      <a href="/contact">Contact</a>

      <a class="quote-btn" href="/contact">
        <span class="quote-icon" aria-hidden="true">▣</span>
        <span>Demande de devis</span>
        <span class="quote-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initialiseMobileMenu() {
    const header = document.querySelector(".header");
    const toggle = header?.querySelector(".mobile-toggle");
    const menu = header?.querySelector(".menu");

    if (!(toggle instanceof HTMLButtonElement)) return;
    if (!(menu instanceof HTMLElement)) return;

    const openMenu = () => {
      menu.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Fermer le menu");
    };

    const closeMenu = () => {
      menu.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Ouvrir le menu");
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      if (!header?.contains(event.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        toggle.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 900) {
        closeMenu();
      }
    });
  }

  document.addEventListener("astro:page-load", initialiseMobileMenu);
  initialiseMobileMenu();
</script>
